<div class="paginakop">
  <div class="wrap">
    <div>
      <span class="kicker">Beheer</span>
      <h1>Galerij beheren</h1>
      <p>Upload eigen foto's of voeg YouTube-video's toe; ze verschijnen op de gekozen pagina.</p>
    </div>
    <a href="/dashboard" class="btn btn--ghost">Terug naar dashboard</a>
  </div>
</div>

<section class="section section--tight">
  <div class="wrap">
    <div class="grid grid--beheer">
      <div class="stack">
      <div class="card">
        <h3 style="margin-top:0;">Foto toevoegen</h3>
        <form action="/galerij?_csrf=<%= csrfToken %>" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="veld">
            <label for="pagina">Pagina</label>
            <select id="pagina" name="pagina">
              <% paginas.forEach(function(p){ %><option value="<%= p.key %>"><%= p.label %></option><% }) %>
            </select>
          </div>
          <div class="veld">
            <label for="bijschrift">Bijschrift (optioneel)</label>
            <input type="text" id="bijschrift" name="bijschrift" placeholder="bijv. Baretuitreiking 2026">
          </div>
          <div class="veld">
            <label for="foto">Afbeelding</label>
            <input type="file" id="foto" name="foto" accept="image/png,image/jpeg,image/webp,image/gif" required>
          </div>
          <button type="submit" class="btn btn--primary btn--block">Uploaden</button>
          <p class="muted" style="font-size:.8rem; margin:12px 0 0;">JPG, PNG of WebP — maximaal 6 MB per foto.</p>
        </form>
      </div>

      <div class="card">
        <h3 style="margin-top:0;">YouTube-video toevoegen</h3>
        <form action="/galerij/youtube" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="veld">
            <label for="yt-pagina">Pagina</label>
            <select id="yt-pagina" name="pagina">
              <% paginas.forEach(function(p){ %><option value="<%= p.key %>"><%= p.label %></option><% }) %>
            </select>
          </div>
          <div class="veld">
            <label for="yt-bijschrift">Bijschrift (optioneel)</label>
            <input type="text" id="yt-bijschrift" name="bijschrift" maxlength="200" placeholder="bijv. Aftermovie sportdag 2026">
          </div>
          <div class="veld">
            <label for="youtube_url">YouTube-link</label>
            <input type="text" id="youtube_url" name="youtube_url" required maxlength="300" placeholder="https://www.youtube.com/watch?v=…">
            <span class="hint">Ook youtu.be- en Shorts-links werken. De video speelt af op de pagina zelf.</span>
          </div>
          <button type="submit" class="btn btn--primary btn--block">Video toevoegen</button>
        </form>
      </div>
      </div>

      <div>
        <% if (!fotos.length) { %>
          <div class="lege-staat"><p class="mb-0">Nog geen foto's geüpload. Voeg links je eerste foto toe.</p></div>
        <% } else { %>
          <% paginas.forEach(function(p){ %>
            <% var groep = fotos.filter(function(f){ return f.pagina === p.key; }); %>
            <% if (groep.length) { %>
              <h3 style="margin:0 0 12px;"><%= p.label %> <span class="muted" style="font-weight:400;">(<%= groep.length %>)</span></h3>
              <div class="foto-galerij" style="margin-bottom:28px;">
                <% groep.forEach(function(f){ %>
                  <figure<%= f.youtube_id ? ' class="video-item"' : '' %>>
                    <% if (f.youtube_id) { %>
                      <span class="video-start" style="cursor:default;">
                        <img src="https://i.ytimg.com/vi/<%= f.youtube_id %>/hqdefault.jpg" alt="<%= f.bijschrift || 'Video' %>">
                        <span class="speelknop" aria-hidden="true"></span>
                      </span>
                    <% } else { %>
                      <img src="/media/<%= f.media_id %>" alt="<%= f.bijschrift || '' %>">
                    <% } %>
                    <figcaption>
                      <%= f.youtube_id ? '▶ ' : '' %><%= f.bijschrift || 'Zonder bijschrift' %>
                      <form action="/galerij/<%= f.id %>/verwijderen" method="post" data-bevestig="<%= f.youtube_id ? 'Deze video' : 'Deze foto' %> uit de galerij verwijderen?" style="margin-top:8px;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn--danger btn--sm">Verwijderen</button>
                      </form>
                    </figcaption>
                  </figure>
                <% }) %>
              </div>
            <% } %>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</section>
