<div class="paginakop">
  <div class="wrap">
    <div>
      <span class="kicker">Partners &amp; initiatieven</span>
      <h1><%= title %></h1>
    </div>
    <a href="/partners" class="btn btn--ghost">← Annuleren</a>
  </div>
</div>

<section class="section">
  <div class="wrap" style="max-width:760px;">
    <% if (fout) { %><div class="flash flash--fout"><%= fout %></div><% } %>
    <form action="<%= actie %>?_csrf=<%= csrfToken %>" method="post" enctype="multipart/form-data" class="form-card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="flex" style="gap:20px; margin-bottom:22px; align-items:flex-start;">
        <div class="partner-logo" style="width:120px; flex:none;">
          <img id="logo-voorbeeld" src="<%= partner.logo_id ? '/media/' + partner.logo_id : '' %>" alt="" <%= partner.logo_id ? '' : 'hidden' %>>
          <span class="initialen" id="logo-initialen" <%= partner.logo_id ? 'hidden' : '' %>><%= h.initialen(partner.naam || '?') %></span>
        </div>
        <div class="veld" style="flex:1; margin:0;">
          <label for="logo">Logo</label>
          <input type="file" id="logo" name="logo" accept="image/png,image/jpeg,image/webp,image/gif" data-voorbeeld="#logo-voorbeeld" data-verberg="#logo-initialen">
          <span class="hint">PNG, JPG, WebP of GIF, max 2 MB. Bij voorkeur een liggend logo met transparante achtergrond.</span>
          <div id="logo-melding" class="hint" style="display:none; color:var(--maroon); margin-top:6px;">Nieuw logo gekozen — nog niet opgeslagen.</div>
          <% if (partner.logo_id) { %>
            <label class="check" style="margin-top:10px; font-weight:500; font-size:.88rem;"><input type="checkbox" name="logo_verwijderen"> Huidig logo verwijderen</label>
          <% } %>
        </div>
      </div>

      <div class="veld">
        <label for="naam">Naam *</label>
        <input type="text" id="naam" name="naam" value="<%= partner.naam || '' %>" required maxlength="150" autofocus>
      </div>
      <div class="veld-rij">
        <div class="veld">
          <label for="categorie">Categorie</label>
          <select id="categorie" name="categorie">
            <option value="">Kies…</option>
            <% categorieen.forEach(function(c){ %>
              <option value="<%= c %>" <%= partner.categorie === c ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
        </div>
        <div class="veld">
          <label for="volgorde">Volgorde</label>
          <input type="number" id="volgorde" name="volgorde" min="0" max="9999" value="<%= partner.volgorde || 0 %>">
          <span class="hint">Lager = eerder in de lijst</span>
        </div>
      </div>
      <div class="veld">
        <label for="samenvatting">Korte omschrijving</label>
        <input type="text" id="samenvatting" name="samenvatting" value="<%= partner.samenvatting || '' %>" maxlength="250" placeholder="In één zin: wat doet deze partner of dit initiatief?">
      </div>
      <div class="veld">
        <label for="omschrijving">Uitgebreide omschrijving</label>
        <textarea id="omschrijving" name="omschrijving" rows="8" maxlength="10000" placeholder="Vertel meer over het initiatief, wat het doet en hoe leden kunnen bijdragen. Laat een lege regel tussen alinea's."><%= partner.omschrijving || '' %></textarea>
      </div>
      <div class="veld-rij">
        <div class="veld"><label for="website">Website</label><input type="text" id="website" name="website" value="<%= partner.website || '' %>" placeholder="www.voorbeeld.nl" maxlength="300"></div>
        <div class="veld"><label for="contact_email">Contact-e-mail</label><input type="email" id="contact_email" name="contact_email" value="<%= partner.contact_email || '' %>" maxlength="200"></div>
      </div>
      <div class="veld-rij">
        <label class="check" style="cursor:pointer;">
          <input type="checkbox" name="uitgelicht" <%= partner.uitgelicht === true || partner.uitgelicht === 'on' ? 'checked' : '' %>>
          Uitgelicht (ook op de homepage tonen)
        </label>
        <label class="check" style="cursor:pointer;">
          <input type="checkbox" name="gepubliceerd" <%= (partner.gepubliceerd === undefined || partner.gepubliceerd === true || partner.gepubliceerd === 'on') ? 'checked' : '' %>>
          Publiceren (uit = concept, alleen zichtbaar voor beheer)
        </label>
      </div>
      <button type="submit" class="btn btn--primary">Opslaan</button>
    </form>
  </div>
</section>
