<div class="paginakop">
  <div class="wrap">
    <div>
      <span class="kicker">Beheer</span>
      <h1>Ledenbeheer</h1>
      <p>Beheer rollen, activeer of deactiveer leden en houd overzicht.</p>
    </div>
  </div>
</div>

<section class="section section--tight">
  <div class="wrap">
    <div class="statbar statbar--4" style="margin-top:0; margin-bottom:32px;">
      <div class="stat"><div class="getal"><%= stats.leden %></div><div class="label">Leden</div></div>
      <div class="stat"><div class="getal"><%= stats.vacatures %></div><div class="label">Vacatures</div></div>
      <div class="stat"><div class="getal"><%= stats.projecten %></div><div class="label">Projecten</div></div>
      <div class="stat"><div class="getal"><%= stats.met_tfa %></div><div class="label">Met 2FA</div></div>
    </div>

    <div class="card" style="margin-bottom:32px;">
      <div class="flex between" style="align-items:flex-start;">
        <div>
          <h3 style="margin:0 0 4px;">Agenda-import van bclmb.nl</h3>
          <p class="muted mb-0" style="font-size:.9rem;">
            <% if (!agendaImport.config.uren) { %>
              Uitgeschakeld (AGENDA_IMPORT_UREN=0).
            <% } else { %>
              Activiteiten van de hoofdsite worden automatisch overgenomen (elke <%= agendaImport.config.uren %> uur). <%= agendaImport.aantal %> geïmporteerd<%= agendaImport.aantal === 1 ? ' evenement' : 'e evenementen' %> in de agenda.
            <% } %>
            <% if (agendaImport.laatste) { %>
              <br>Laatste import: <%= new Date(agendaImport.laatste.tijdstip).toLocaleString('nl-NL', { timeZone: 'Europe/Amsterdam' }) %> —
              <%= agendaImport.laatste.nieuw %> nieuw, <%= agendaImport.laatste.bijgewerkt %> bijgewerkt, <%= agendaImport.laatste.ongewijzigd %> ongewijzigd, <%= agendaImport.laatste.verwijderd %> verwijderd<%= agendaImport.laatste.overgeslagen ? ', ' + agendaImport.laatste.overgeslagen + ' genegeerd' : '' %>.
              <% if (agendaImport.laatste.fouten.length) { %><br><span style="color:#8a2020;">Meldingen: <%= agendaImport.laatste.fouten.join(' | ') %></span><% } %>
            <% } else if (agendaImport.config.uren) { %>
              <br>Nog niet gedraaid sinds de laatste herstart.
            <% } %>
          </p>
        </div>
        <div class="flex" style="gap:8px;">
          <form action="/beheer/agenda-import" method="post" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--primary btn--sm" type="submit" <%= agendaImport.bezig ? 'disabled' : '' %>>Nu importeren</button>
          </form>
          <% if (agendaImport.genegeerd > 0) { %>
            <form action="/beheer/agenda-import/negeer-wissen" method="post" class="inline-form" data-bevestig="De <%= agendaImport.genegeerd %> door jou verwijderde evenement(en) van bclmb.nl worden bij de volgende import weer toegevoegd. Doorgaan?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn--ghost btn--sm" type="submit">Verwijderde weer toestaan (<%= agendaImport.genegeerd %>)</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom:32px;">
      <div class="flex between" style="align-items:flex-start;">
        <div>
          <h3 style="margin:0 0 4px;">Nieuws-import van bclmb.nl</h3>
          <p class="muted mb-0" style="font-size:.9rem;">
            <% if (!nieuwsImport.config.uren) { %>
              Uitgeschakeld (NIEUWS_IMPORT_UREN=0).
            <% } else { %>
              Nieuws<%= nieuwsImport.config.blog ? ' en blogs' : '' %> van de hoofdsite worden automatisch overgenomen (elke <%= nieuwsImport.config.uren %> uur). <%= nieuwsImport.aantal %> overgenomen bericht<%= nieuwsImport.aantal === 1 ? '' : 'en' %>.
            <% } %>
            <% if (nieuwsImport.laatste) { %>
              <br>Laatste import: <%= new Date(nieuwsImport.laatste.tijdstip).toLocaleString('nl-NL', { timeZone: 'Europe/Amsterdam' }) %> —
              <%= nieuwsImport.laatste.nieuw %> nieuw, <%= nieuwsImport.laatste.bijgewerkt %> bijgewerkt, <%= nieuwsImport.laatste.ongewijzigd %> ongewijzigd<%= nieuwsImport.laatste.overgeslagen ? ', ' + nieuwsImport.laatste.overgeslagen + ' genegeerd' : '' %>.
              <% if (nieuwsImport.laatste.fouten.length) { %><br><span style="color:#8a2020;">Meldingen: <%= nieuwsImport.laatste.fouten.join(' | ') %></span><% } %>
            <% } else if (nieuwsImport.config.uren) { %>
              <br>Nog niet gedraaid sinds de laatste herstart.
            <% } %>
          </p>
        </div>
        <div class="flex" style="gap:8px;">
          <form action="/beheer/nieuws-import" method="post" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--primary btn--sm" type="submit" <%= nieuwsImport.bezig ? 'disabled' : '' %>>Nu importeren</button>
          </form>
          <% if (nieuwsImport.genegeerd > 0) { %>
            <form action="/beheer/nieuws-import/negeer-wissen" method="post" class="inline-form" data-bevestig="De <%= nieuwsImport.genegeerd %> door jou verwijderde bericht(en) van bclmb.nl worden bij de volgende import weer overgenomen. Doorgaan?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn--ghost btn--sm" type="submit">Verwijderde weer toestaan (<%= nieuwsImport.genegeerd %>)</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom:32px;">
      <div class="flex between" style="align-items:flex-start;">
        <div>
          <h3 style="margin:0 0 4px;">Sponsorverzoeken voor militairen &amp; veteranen</h3>
          <p class="muted mb-0" style="font-size:.9rem;">
            <% if (sponsor.teControleren) { %>
              <strong style="color:var(--maroon);"><%= sponsor.teControleren === 1 ? '1 nieuw verzoek wacht' : sponsor.teControleren + ' nieuwe verzoeken wachten' %> op controle.</strong>
            <% } else { %>
              Geen verzoeken die op controle wachten.
            <% } %>
            <%= sponsor.geplaatst %> <%= sponsor.geplaatst === 1 ? 'verzoek staat' : 'verzoeken staan' %> op de site.
            <% if (!sponsor.config.uren) { %>
              <br>Automatisch ophalen staat uit (SPONSOR_IMPORT_UREN=0).
            <% } else { %>
              <br>De assistent zoekt elke ochtend; de lijst wordt elke <%= sponsor.config.uren %> uur opgehaald.
            <% } %>
            <% if (sponsor.laatste) { %>
              Laatst opgehaald: <%= new Date(sponsor.laatste.tijdstip).toLocaleString('nl-NL', { timeZone: 'Europe/Amsterdam' }) %> —
              <%= sponsor.laatste.nieuw %> nieuw, <%= sponsor.laatste.dubbel %> al bekend.
              <% if (sponsor.laatste.fouten.length) { %><br><span style="color:#8a2020;">Meldingen: <%= sponsor.laatste.fouten.join(' | ') %></span><% } %>
            <% } %>
          </p>
        </div>
        <div class="flex" style="gap:8px;">
          <a href="/sponsorverzoeken/controle" class="btn btn--primary btn--sm">Controleren<%= sponsor.teControleren ? ' (' + sponsor.teControleren + ')' : '' %></a>
          <form action="/sponsorverzoeken/controle/ophalen" method="post" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--ghost btn--sm" type="submit" <%= sponsor.bezig ? 'disabled' : '' %>>Nu ophalen</button>
          </form>
        </div>
      </div>
    </div>

    <div style="overflow-x:auto;">
      <table class="tabel">
        <thead>
          <tr><th>Naam</th><th>E-mail</th><th>Rol</th><th>Status</th><th>2FA</th><th>Acties</th></tr>
        </thead>
        <tbody>
          <% leden.forEach(function(l){ %>
            <tr>
              <td>
                <strong><%= l.naam %></strong>
                <% if (l.bedrijf) { %><div class="meta"><%= l.bedrijf %></div><% } %>
              </td>
              <td class="muted"><%= l.email %></td>
              <td>
                <% if (l.id === user.id) { %>
                  <span class="badge badge--brigade">Jij (admin)</span>
                <% } else { %>
                  <form action="/beheer/lid/<%= l.id %>/rol" method="post" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <select name="rol" data-auto-submit aria-label="Rol van <%= l.naam %>">
                      <option value="lid" <%= l.rol === 'lid' ? 'selected' : '' %>>Lid</option>
                      <option value="brigade" <%= l.rol === 'brigade' ? 'selected' : '' %>>Brigade</option>
                      <option value="admin" <%= l.rol === 'admin' ? 'selected' : '' %>>Admin</option>
                    </select>
                  </form>
                <% } %>
              </td>
              <td>
                <% if (l.actief) { %><span class="badge badge--olive">Actief</span><% } else { %><span class="badge">Inactief</span><% } %>
              </td>
              <td>
                <% if (l.totp_ingeschakeld) { %>
                  <span class="badge badge--olive" title="Tweestapsverificatie ingeschakeld">Aan</span>
                  <% if (l.id !== user.id) { %>
                    <form action="/beheer/lid/<%= l.id %>/2fa-reset" method="post" class="inline-form" data-bevestig="Tweestapsverificatie van <%= l.naam %> uitschakelen? Doe dit alleen als dit lid geen toegang meer heeft tot de authenticator-app en geen herstelcodes heeft.">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn--ghost btn--sm" type="submit" title="2FA resetten">Reset</button>
                    </form>
                  <% } %>
                <% } else { %>
                  <span class="badge">Uit</span>
                <% } %>
              </td>
              <td>
                <% if (l.id !== user.id) { %>
                  <div class="flex" style="gap:6px;">
                    <form action="/beheer/lid/<%= l.id %>/status" method="post" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn--ghost btn--sm" type="submit"><%= l.actief ? 'Deactiveren' : 'Activeren' %></button>
                    </form>
                    <form action="/beheer/lid/<%= l.id %>/verwijderen" method="post" class="inline-form" data-bevestig="Dit lid definitief verwijderen? Alle vacatures en projecten van dit lid verdwijnen ook.">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn--danger btn--sm" type="submit" aria-label="Verwijderen">×</button>
                    </form>
                  </div>
                <% } else { %>
                  <span class="muted">—</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="card" style="margin-top:32px;">
      <h3 style="margin:0 0 4px;">Versie van de site</h3>
      <p class="muted mb-0" style="font-size:.9rem;">
        Online staat <strong>versie <%= versie.nummer %></strong><% if (versie.commit) { %> (update <code><%= versie.commit %></code><%= versie.tak ? ', tak ' + versie.tak : '' %>)<% } %>.
        <% if (versie.bericht) { %><br>Laatste wijziging: <em><%= versie.bericht %></em><% } %>
        <br>Gestart op <%= new Date(versie.gestart).toLocaleString('nl-NL', { timeZone: 'Europe/Amsterdam' }) %>. Het versienummer wordt bij elke update opgehoogd; de wijzigingen per versie staan in CHANGELOG.md in de repository.
      </p>
    </div>
    <p class="muted" style="margin-top:16px; font-size:.85rem;">Tip: zet een lid op <strong>Brigade</strong> om die persoon de veteranenhub te laten beheren. <strong>Admin</strong> geeft volledige toegang tot dit beheerpaneel. Met <strong>Reset</strong> schakel je de tweestapsverificatie van een lid uit dat zijn telefoon en herstelcodes kwijt is.</p>
  </div>
</section>
