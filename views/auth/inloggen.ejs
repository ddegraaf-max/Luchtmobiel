<div class="auth-wrap">
  <div class="auth-card">
    <a href="/" class="auth-logo">
      <img src="/static/img/logo.png?v=2" alt="Business Club Luchtmobiel embleem">
      <span>Business Club Luchtmobiel</span>
    </a>
    <span class="kicker">Welkom terug</span>
    <h1>Inloggen</h1>
    <p class="muted">Log in op het ledenplatform.</p>

    <% if (fout) { %><div class="flash flash--fout"><%= fout %></div><% } %>

    <form action="/inloggen" method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="veld">
        <label for="email">E-mailadres</label>
        <input type="email" id="email" name="email" value="<%= waarden.email || '' %>" required autofocus autocomplete="email">
      </div>
      <div class="veld">
        <label for="wachtwoord">Wachtwoord</label>
        <input type="password" id="wachtwoord" name="wachtwoord" required autocomplete="current-password">
        <span class="hint"><a href="/wachtwoord-vergeten">Wachtwoord vergeten?</a></span>
      </div>
      <%- include('../partials/turnstile') %>
      <button type="submit" class="btn btn--primary btn--block">Inloggen</button>
    </form>

    <div class="auth-onder">Nog geen account? <a href="/registreren">Word lid</a></div>
  </div>
</div>
