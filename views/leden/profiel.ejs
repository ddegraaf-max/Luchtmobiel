<div class="paginakop">
  <div class="wrap">
    <div>
      <span class="kicker">Mijn profiel</span>
      <h1>Profiel beheren</h1>
      <p>Zo zie je eruit in de ledengids.</p>
    </div>
    <div class="flex">
      <a href="/profiel/beveiliging" class="btn btn--ghost">🔐 Beveiliging</a>
      <a href="/leden/<%= profiel.id %>" class="btn btn--ghost">Bekijk mijn profiel</a>
    </div>
  </div>
</div>

<section class="section">
  <div class="wrap" style="max-width:760px;">
    <form action="/profiel?_csrf=<%= csrfToken %>" method="post" enctype="multipart/form-data" class="form-card"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="flex logo-kiezer" style="gap:20px; margin-bottom:22px; align-items:flex-start;">
        <div class="logo-kiezer__beeld">
          <img class="avatar avatar--lg" id="logo-voorbeeld" src="<%= profiel.logo_id ? '/media/' + profiel.logo_id : '' %>" alt="" <%= profiel.logo_id ? '' : 'hidden' %>>
          <span class="avatar avatar--lg" id="logo-initialen" <%= profiel.logo_id ? 'hidden' : '' %>><%= h.initialen(profiel.bedrijf || profiel.naam) %></span>
        </div>
        <div class="veld" style="flex:1; margin:0;">
          <label for="logo">Logo of foto</label>
          <input type="file" id="logo" name="logo" accept="image/png,image/jpeg,image/webp,image/gif" data-voorbeeld="#logo-voorbeeld" data-verberg="#logo-initialen">
          <span class="hint">PNG, JPG, WebP of GIF, max 2 MB. Je ziet direct een voorbeeld; het wordt pas bewaard als je op <strong>Profiel opslaan</strong> klikt.</span>
          <div id="logo-melding" class="hint" style="display:none; color:var(--maroon); margin-top:6px;">Nieuw logo gekozen — nog niet opgeslagen.</div>
          <% if (profiel.logo_id) { %>
            <label class="check" style="margin-top:10px; font-weight:500; font-size:.88rem;"><input type="checkbox" name="logo_verwijderen"> Huidig logo verwijderen</label>
          <% } %>
        </div>
      </div>

      <div class="veld">
        <label for="naam">Naam</label>
        <input type="text" id="naam" name="naam" value="<%= profiel.naam || '' %>" maxlength="120" autocomplete="name">
      </div>
      <div class="veld-rij">
        <div class="veld"><label for="bedrijf">Bedrijf</label><input type="text" id="bedrijf" name="bedrijf" value="<%= profiel.bedrijf || '' %>" maxlength="120" autocomplete="organization"></div>
        <div class="veld"><label for="functie">Functie</label><input type="text" id="functie" name="functie" value="<%= profiel.functie || '' %>" maxlength="120" autocomplete="organization-title"></div>
      </div>
      <div class="veld-rij">
        <div class="veld"><label for="branche">Branche</label>
          <input type="text" id="branche" name="branche" value="<%= profiel.branche || '' %>" placeholder="Kies of typ je eigen branche" list="branche-opties" maxlength="120">
          <datalist id="branche-opties">
            <option value="Bouw &amp; constructie"></option>
            <option value="Installatietechniek"></option>
            <option value="Vastgoed &amp; makelaardij"></option>
            <option value="ICT &amp; software"></option>
            <option value="Marketing &amp; communicatie"></option>
            <option value="Advies &amp; consultancy"></option>
            <option value="Financieel &amp; administratie"></option>
            <option value="Juridisch"></option>
            <option value="Verzekeringen"></option>
            <option value="HR &amp; werving"></option>
            <option value="Beveiliging"></option>
            <option value="Logistiek &amp; transport"></option>
            <option value="Productie &amp; industrie"></option>
            <option value="Groothandel"></option>
            <option value="Detailhandel"></option>
            <option value="Horeca &amp; catering"></option>
            <option value="Zorg &amp; welzijn"></option>
            <option value="Sport &amp; gezondheid"></option>
            <option value="Onderwijs &amp; training"></option>
            <option value="Energie &amp; duurzaamheid"></option>
            <option value="Automotive"></option>
            <option value="Landbouw &amp; groen"></option>
            <option value="Evenementen"></option>
            <option value="Reizen &amp; recreatie"></option>
            <option value="Kunst &amp; creatief"></option>
            <option value="Defensie &amp; veiligheid"></option>
            <option value="Overheid &amp; non-profit"></option>
            <option value="Overig"></option>
          </datalist>
        </div>
        <div class="veld"><label for="plaats">Plaats</label><input type="text" id="plaats" name="plaats" value="<%= profiel.plaats || '' %>" maxlength="120" autocomplete="address-level2"></div>
      </div>
      <div class="veld-rij">
        <div class="veld"><label for="telefoon">Telefoon</label><input type="tel" id="telefoon" name="telefoon" value="<%= profiel.telefoon || '' %>" maxlength="40" autocomplete="tel"></div>
        <div class="veld"><label for="website">Website</label><input type="text" id="website" name="website" value="<%= profiel.website || '' %>" placeholder="www.voorbeeld.nl" maxlength="300" autocomplete="url"></div>
      </div>
      <div class="veld">
        <label for="bio">Over jou / je bedrijf</label>
        <textarea id="bio" name="bio" maxlength="4000" placeholder="Vertel kort wie je bent, wat je doet en waarmee je andere leden kunt helpen."><%= profiel.bio || '' %></textarea>
      </div>
      <button type="submit" class="btn btn--primary">Profiel opslaan</button>
    </form>

    <a href="/profiel/beveiliging" class="module" style="margin-top:24px;">
      <h3>🔐 Beveiliging</h3>
      <p>Wachtwoord wijzigen, tweestapsverificatie met een authenticator-app instellen en ingelogde apparaten beheren.</p>
      <span class="pijl">Naar beveiliging →</span>
    </a>
  </div>
</section>
