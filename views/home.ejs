<%# Homepage in de huisstijl: foto-hero met rode accentbalk, iconenrij en drie panelen met een rode kopbalk. %>
<section class="hero hero--foto" style="background-image:url('/static/img/hero-chinook.jpg?v=1');">
  <div class="wrap">
    <div class="hero-tekst">
      <span class="kicker reveal">Platform voor veteranenzaken &amp; het ledennetwerk</span>
      <h1 class="reveal d1"><span class="wit">Eén netwerk.</span><span class="goud">Voor ondernemen, verbinden en ondersteunen.</span></h1>
      <p class="lede reveal d2">Naast de officiële clubwebsite <a href="https://www.bclmb.nl" target="_blank" rel="noopener">www.bclmb.nl</a> is dit het platform van Business Club Luchtmobiel voor veteranenzaken, de ledengids, vacatures, projecten, agenda, partners en sponsoring.</p>
      <div class="hero-acties reveal d3">
        <% if (user) { %>
          <a href="/leden" class="btn btn--goud">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Naar de ledengids
          </a>
          <a href="/dashboard" class="btn btn--ghost">Mijn dashboard</a>
        <% } else { %>
          <a href="/registreren" class="btn btn--goud">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.54l.34.26a3 3 0 0 0 3.2 0L22 8"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>
            Word lid
          </a>
          <a href="/over" class="btn btn--ghost">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Ontdek het netwerk
          </a>
        <% } %>
      </div>
    </div>
  </div>
</section>

<nav class="snelmenu" aria-label="Snel naar">
  <div class="wrap">
    <div class="snelmenu__lijst">
      <a href="/veteranen" class="snelmenu__hoofd">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.5 13.3 17 23l-5-3-5 3 1.5-9.7"/><path d="m12 5 .9 1.9 2.1.3-1.5 1.5.4 2.1L12 9.8l-1.9 1 .4-2.1L9 7.2l2.1-.3z"/></svg>
        <span class="tekst"><strong>Veteranenzaken</strong><span>Hulpbronnen, contacten en passend werk</span></span>
      </a>
      <a href="/leden">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span class="tekst"><strong>Ledengids</strong><span>Onze leden en bedrijven</span></span>
      </a>
      <a href="/vacatures">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><path d="M2 13h20"/></svg>
        <span class="tekst"><strong>Vacatures</strong><span>Kansen binnen ons netwerk</span></span>
      </a>
      <a href="/projecten">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
        <span class="tekst"><strong>Projecten</strong><span>Initiatieven en samenwerking</span></span>
      </a>
      <a href="/agenda">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span class="tekst"><strong>Agenda</strong><span>Evenementen en bijeenkomsten</span></span>
      </a>
    </div>
  </div>
</nav>

<%
  var rcHome = typeof kiesReclames === 'function' ? (kiesReclames() || []).slice(0, 3) : [];
  var rcMailHome = 'mailto:' + ((typeof reclameLib !== 'undefined' && reclameLib) ? reclameLib.contactAdres() : 'info@bclmb.nl') + '?subject=' + encodeURIComponent('Adverteren op het ledenplatform van de Business Club Luchtmobiel');
  var chevron = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>';
  var pin = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>';
  var kalender = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>';
%>
<section class="section section--tight">
  <div class="wrap">
    <div class="panelen">

      <div class="paneel">
        <div class="paneel__kop"><h2>Aankomende evenementen</h2><a href="/agenda" aria-label="Naar de hele agenda"><%- chevron %></a></div>
        <div class="paneel__inhoud">
          <% if (!evenementen.length) { %>
            <p class="lege">Er staan nog geen evenementen in de agenda.</p>
          <% } %>
          <% evenementen.forEach(function(e){ var dk = h.formatDatumKort(e.start_op).split(' '); %>
            <a href="/agenda/<%= e.id %>" class="evt">
              <span class="datumtegel"><span class="dag"><%= dk[0] %></span><span class="maand"><%= dk[1] %></span></span>
              <span class="evt__tekst">
                <strong><%= e.titel %></strong>
                <span class="sub"><%= e.categorie ? e.categorie + ' · ' : '' %><%= e.hele_dag ? 'Hele dag' : h.formatTijd(e.start_op) + ' uur' %></span>
                <% if (e.locatie) { %><span class="plek"><%- pin %> <%= e.locatie %></span><% } %>
              </span>
            </a>
          <% }) %>
        </div>
        <div class="paneel__voet"><a href="/agenda" class="btn btn--ghost btn--sm btn--block">Hele agenda</a></div>
      </div>

      <div class="paneel">
        <div class="paneel__kop"><h2>Nieuws uit het netwerk</h2><a href="/nieuws" aria-label="Naar alle nieuwsberichten"><%- chevron %></a></div>
        <div class="paneel__inhoud">
          <% if (!nieuws.length) { %>
            <p class="lege">Er is nog geen nieuws geplaatst.</p>
          <% } else { var eerste = nieuws[0]; %>
            <a href="/nieuws/<%= eerste.id %>" class="nieuws-top">
              <% if (eerste.afbeelding_id) { %><img src="/media/<%= eerste.afbeelding_id %>" alt="" loading="lazy"><% } %>
              <div class="titel"><%= eerste.titel %></div>
              <% if (!eerste.afbeelding_id) { %><p class="samenvatting"><%= h.kort(eerste.inhoud, 140) %></p><% } %>
              <div class="datum"><%- kalender %> <%= h.formatDatum(eerste.aangemaakt) %></div>
            </a>
            <% if (nieuws.length > 1) { %>
              <ul class="nieuws-meer">
                <% nieuws.slice(1).forEach(function(n){ %>
                  <li><a href="/nieuws/<%= n.id %>"><%= n.titel %></a><div class="meta"><%= h.formatDatum(n.aangemaakt) %></div></li>
                <% }) %>
              </ul>
            <% } %>
          <% } %>
        </div>
        <div class="paneel__voet"><a href="/nieuws" class="btn btn--ghost btn--sm btn--block">Alle berichten</a></div>
      </div>

      <div class="paneel">
        <div class="paneel__kop"><h2>Onze partners</h2><a href="/partners" aria-label="Naar alle partners"><%- chevron %></a></div>
        <div class="paneel__inhoud">
          <% rcHome.forEach(function(rc){ %><%- include('partials/reclame', { variant: 'mini', item: rc, tel: false }) %><% }) %>
          <% if (partners.length) { %>
            <div class="paneel__partners">
              <% partners.slice(0, 4).forEach(function(p){ %>
                <a href="/partners/<%= p.id %>" title="<%= p.samenvatting || p.naam %>">
                  <span class="partner-logo">
                    <% if (p.logo_id) { %><img src="/media/<%= p.logo_id %>" alt="Logo <%= p.naam %>" loading="lazy"><% } else { %><span class="initialen"><%= h.initialen(p.naam) %></span><% } %>
                  </span>
                  <span><%= p.naam %></span>
                </a>
              <% }) %>
            </div>
          <% } %>
          <% if (!rcHome.length && !partners.length) { %>
            <p class="lege">Nog geen partners geplaatst.</p>
          <% } %>
          <p class="paneel__adverteren">Ook jouw bedrijf onder de aandacht van het netwerk? <a href="<%= rcMailHome %>">Mail het bestuur</a>.</p>
        </div>
        <div class="paneel__voet"><a href="/partners" class="btn btn--ghost btn--sm btn--block">Alle partners</a></div>
      </div>

    </div>
  </div>
</section>

<section class="veteranen-band">
  <div class="wrap">
    <span class="kicker">Veteranenzaken · waar dit platform voor is</span>
    <h2>Voor wie gediend heeft, en voor wie hen wil steunen.</h2>
    <p>Business Club Luchtmobiel heeft een officiële website, <a href="https://www.bclmb.nl" target="_blank" rel="noopener">www.bclmb.nl</a>. Dit platform is daarnaast speciaal ingericht voor veteranenzaken — hulpbronnen, contacten en passend werk, verzorgd door 11 Luchtmobiele Brigade en het bestuur — en voor alles wat het netwerk praktisch nodig heeft.</p>
    <ul class="veteranen-punten">
      <li>Hulpbronnen en contacten voor veteranen</li>
      <li>Vacatures die passen bij veteranen</li>
      <li>Sponsorverzoeken voor militairen en veteranen</li>
      <li>Projecten die steun zoeken</li>
    </ul>
    <div class="flex">
      <a href="/veteranen" class="btn btn--goud">Naar veteranenzaken</a>
      <a href="/sponsorverzoeken" class="btn btn--ghost">Sponsorverzoeken</a>
    </div>
  </div>
</section>

<% if (vacatures.length || projecten.length) { %>
<section class="section section--tight" style="background:var(--white); border-top:1px solid var(--line); border-bottom:1px solid var(--line);">
  <div class="wrap">
    <div class="grid grid--2" style="gap:40px;">
      <div>
        <div class="flex between" style="margin-bottom:18px;">
          <h2 style="margin:0;">Recente vacatures</h2>
          <a href="/vacatures" class="muted" style="font-weight:600;">Alles →</a>
        </div>
        <div class="stack">
          <% if (!vacatures.length) { %><p class="muted">Nog geen vacatures geplaatst.</p><% } %>
          <% vacatures.forEach(function(v){ %>
            <div class="card" style="padding:18px 20px;">
              <div class="flex between">
                <div>
                  <a class="card-titel" href="<%= user ? '/vacatures/' + v.id : '/inloggen' %>" style="font-family:var(--font-display); font-weight:800; font-size:1.05rem;"><%= v.titel %></a>
                  <div class="meta"><%= v.bedrijf || '' %><%= v.plaats ? ' · ' + v.plaats : '' %></div>
                </div>
                <% if (v.veteraan_vriendelijk) { %><span class="badge badge--maroon">Veteraan welkom</span><% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
      <div>
        <div class="flex between" style="margin-bottom:18px;">
          <h2 style="margin:0;">Projecten met een steunvraag</h2>
          <a href="/projecten" class="muted" style="font-weight:600;">Alles →</a>
        </div>
        <div class="stack">
          <% if (!projecten.length) { %><p class="muted">Nog geen projecten geplaatst.</p><% } %>
          <% projecten.forEach(function(p){ %>
            <div class="card" style="padding:18px 20px;">
              <div class="flex between" style="align-items:flex-start;">
                <div>
                  <a class="card-titel" href="<%= user ? '/projecten/' + p.id : '/inloggen' %>" style="font-family:var(--font-display); font-weight:800; font-size:1.05rem;"><%= p.titel %></a>
                  <div class="meta"><%= h.kort(p.samenvatting, 90) %></div>
                </div>
                <% if (p.steun_type) { %><span class="badge badge--olive"><%= p.steun_type %></span><% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>
<% } %>

<div style="height:44px;"></div>
<%- include('partials/reclame', { variant: 'groot' }) %>

<section class="section foto-sectie">
  <div class="wrap">
    <span class="kicker">De brigade</span>
    <h2 style="margin-bottom:8px;">11 Luchtmobiele Brigade in beeld</h2>
    <p class="muted" style="max-width:60ch; margin-bottom:26px;">Het netwerk is verbonden met de luchtmobiele brigade &mdash; snel, licht en overal inzetbaar.</p>
    <%- include('partials/galerij', { fotos: galerij }) %>
    <p style="margin-top:18px;"><a href="/eenheden" class="btn btn--ghost">Meer over de brigade</a></p>
  </div>
</section>

<section class="section">
  <div class="wrap center">
    <span class="kicker" style="justify-content:center;">Doe mee</span>
    <h2 style="max-width:20ch; margin:0 auto .6rem;">Klaar om je aan te sluiten bij het netwerk?</h2>
    <p class="muted" style="max-width:48ch; margin:0 auto 1.8rem;">Maak in een paar minuten je profiel aan met de toegangscode van het bestuur. Daarna beheer je alles zelf.</p>
    <% if (user) { %>
      <a href="/profiel" class="btn btn--primary">Mijn profiel aanvullen</a>
    <% } else { %>
      <a href="/registreren" class="btn btn--goud">Word lid</a>
    <% } %>
  </div>
</section>
