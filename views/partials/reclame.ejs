<%
  // Reclameblok. Gebruik: include('partials/reclame', { variant: 'groot' | 'balk' | 'kaart' }).
  // Zonder 'item' kiest de site zelf een lopend blok (één per pagina, gewogen toeval); met 'item'
  // wordt precies dat blok getoond (voorbeeld in Beheer). tel: false telt geen vertoning;
  // kaal: true laat bij 'groot' de sectie-omlijsting weg.
  var rcVariant = (typeof variant !== 'undefined' && variant) || 'balk';
  var rcLib = typeof reclameLib !== 'undefined' ? reclameLib : null;
  var rc = (typeof item !== 'undefined' && item) ? item : (typeof kiesReclame === 'function' ? kiesReclame() : null);
  var rcKaal = typeof kaal !== 'undefined' && !!kaal;
%>
<% if (rc && rcLib) {
  if (typeof tel === 'undefined' || tel) rcLib.telVertoning(rc.id);
  var rcLogo = rcLib.logoSrc(rc);
  var rcFoto = rcLib.fotoSrc(rc);
  var rcDiensten = rcLib.lijst(rc.diensten, 14);
  var rcKenmerken = rcLib.lijst(rc.kenmerken, 6);
  var rcAccent = rcLib.netteHex(rc.accent) || '#a98443';
  var rcLogoBg = rcLib.netteHex(rc.logo_achtergrond) || '#ffffff';
  var rcKlik = '/reclame/' + rc.id + '/klik';
  var rcLink = !!(rc.cta_url || rc.website);
  var rcCta = rc.cta_tekst || 'Bekijk website';
  var rcWa = rcLib.waUrl(rc.whatsapp);
  var rcTel = rcLib.telHref(rc.telefoon);
  var rcThema = ['donker', 'baret', 'licht'].indexOf(rc.thema) >= 0 ? rc.thema : 'donker';
  var rcStijl = '--rc-accent:' + rcAccent + '; --rc-accent-tekst:' + rcLib.tekstKleur(rcAccent) + '; --rc-logo-bg:' + rcLogoBg + ';';
  var rcKlasse = 'reclame reclame--' + rcVariant + ' reclame--' + rcThema;
  var rcMail = 'mailto:' + rcLib.contactAdres() + '?subject=' + encodeURIComponent('Adverteren op het ledenplatform van de Business Club Luchtmobiel');
%>
<% if (rcVariant === 'groot') { %>
<% if (!rcKaal) { %><section class="section section--tight reclame-sectie"><div class="wrap"><% } %>
<article class="<%= rcKlasse %>" style="<%= rcStijl %>" aria-label="Advertentie: <%= rc.naam %>">
  <div class="reclame__kader">
    <div class="reclame__inhoud">
      <div class="reclame__kop">
        <% if (rcLogo) { %>
          <% if (rcLink) { %><a class="reclame__logo" href="<%= rcKlik %>" target="_blank" rel="noopener sponsored"><img src="<%= rcLogo %>" alt="Logo <%= rc.naam %>" loading="lazy"></a><% } else { %><div class="reclame__logo"><img src="<%= rcLogo %>" alt="Logo <%= rc.naam %>" loading="lazy"></div><% } %>
        <% } %>
        <div class="reclame__titels">
          <span class="reclame__kicker">Partner van het netwerk</span>
          <h2 class="reclame__naam"><%= rc.naam %></h2>
          <% if (rc.slogan) { %><div class="reclame__slogan"><%= rc.slogan %></div><% } %>
        </div>
        <span class="reclame__label" title="Betaalde vermelding van een bedrijf uit het netwerk">Advertentie</span>
      </div>
      <% if (rc.kop) { %><p class="reclame__titel"><%= rc.kop %></p><% } %>
      <% if (rc.tekst) { %><p class="reclame__tekst"><%= rc.tekst %></p><% } %>
      <% if (rcDiensten.length) { %>
        <div class="reclame__kopje">Diensten</div>
        <ul class="reclame__diensten"><% rcDiensten.forEach(function(d){ %><li><%= d %></li><% }) %></ul>
      <% } %>
      <% if (rcKenmerken.length) { %>
        <ul class="reclame__kenmerken"><% rcKenmerken.forEach(function(k){ %><li><%= k %></li><% }) %></ul>
      <% } %>
      <div class="reclame__acties">
        <% if (rcLink) { %><a class="btn reclame__cta" href="<%= rcKlik %>" target="_blank" rel="noopener sponsored"><%= rcCta %> ↗</a><% } %>
        <% if (rcTel) { %><a class="btn btn--ghost" href="<%= rcTel %>">Bel <%= rc.telefoon %></a><% } %>
        <% if (rcWa) { %><a class="btn btn--ghost" href="<%= rcWa %>" target="_blank" rel="noopener">WhatsApp</a><% } %>
        <% if (rc.email) { %><a class="btn btn--ghost" href="mailto:<%= rc.email %>">E-mail</a><% } %>
      </div>
      <% if (rc.website || rc.plaats || rc.regio) { %>
        <div class="reclame__voet">
          <% if (rc.website) { %><span><%= h.toonUrl(rc.website) %></span><% } %>
          <% if (rc.plaats) { %><span><%= rc.plaats %></span><% } %>
          <% if (rc.regio) { %><span>Werkgebied: <%= rc.regio %></span><% } %>
        </div>
      <% } %>
    </div>
    <% if (rcFoto) { %>
      <% if (rcLink) { %><a class="reclame__foto" href="<%= rcKlik %>" target="_blank" rel="noopener sponsored" tabindex="-1" aria-hidden="true"><img src="<%= rcFoto %>" alt="" loading="lazy"></a><% } else { %><div class="reclame__foto"><img src="<%= rcFoto %>" alt="" loading="lazy"></div><% } %>
    <% } %>
  </div>
  <p class="reclame__adverteren">Ook jouw bedrijf onder de aandacht van het netwerk? <a href="<%= rcMail %>">Mail het bestuur</a>.</p>
</article>
<% if (!rcKaal) { %></div></section><% } %>

<% } else if (rcVariant === 'kaart') { %>
<aside class="<%= rcKlasse %>" style="<%= rcStijl %>" aria-label="Advertentie: <%= rc.naam %>">
  <div class="reclame__kader">
    <% if (rcFoto) { %>
      <% if (rcLink) { %><a class="reclame__foto" href="<%= rcKlik %>" target="_blank" rel="noopener sponsored" tabindex="-1" aria-hidden="true"><img src="<%= rcFoto %>" alt="" loading="lazy"></a><% } else { %><div class="reclame__foto"><img src="<%= rcFoto %>" alt="" loading="lazy"></div><% } %>
    <% } %>
    <div class="reclame__inhoud">
      <div class="reclame__kicker">Partner van het netwerk <span class="reclame__label">Advertentie</span></div>
      <% if (rcLogo) { %><div class="reclame__logo"><img src="<%= rcLogo %>" alt="Logo <%= rc.naam %>" loading="lazy"></div><% } %>
      <div class="reclame__naam"><%= rc.naam %></div>
      <% if (rc.slogan) { %><div class="reclame__slogan"><%= rc.slogan %></div><% } %>
      <% if (rc.kop || rc.tekst) { %><p class="reclame__tekst"><%= rc.kop || h.kort(rc.tekst, 120) %></p><% } %>
      <% if (rcDiensten.length) { %><div class="reclame__inline"><%= rcDiensten.slice(0, 5).join(' · ') %></div><% } %>
      <% if (rcLink) { %><a class="btn reclame__cta btn--block" href="<%= rcKlik %>" target="_blank" rel="noopener sponsored"><%= rcCta %> ↗</a><% } %>
      <% if (rcTel) { %><a class="reclame__tel" href="<%= rcTel %>">Bel <%= rc.telefoon %></a><% } else if (rcWa) { %><a class="reclame__tel" href="<%= rcWa %>" target="_blank" rel="noopener">Stuur een WhatsApp</a><% } %>
    </div>
  </div>
</aside>

<% } else { %>
<aside class="<%= rcKlasse %>" style="<%= rcStijl %>" aria-label="Advertentie: <%= rc.naam %>">
  <div class="reclame__kader">
    <% if (rcLogo) { %>
      <% if (rcLink) { %><a class="reclame__logo" href="<%= rcKlik %>" target="_blank" rel="noopener sponsored"><img src="<%= rcLogo %>" alt="Logo <%= rc.naam %>" loading="lazy"></a><% } else { %><div class="reclame__logo"><img src="<%= rcLogo %>" alt="Logo <%= rc.naam %>" loading="lazy"></div><% } %>
    <% } %>
    <div class="reclame__midden">
      <div class="reclame__kicker">Partner van het netwerk <span class="reclame__label">Advertentie</span></div>
      <div class="reclame__naam"><%= rc.naam %><% if (rc.slogan) { %> <span class="reclame__slogan">· <%= rc.slogan %></span><% } %></div>
      <% if (rc.kop || rc.tekst) { %><p class="reclame__tekst"><%= rc.kop || h.kort(rc.tekst, 150) %></p><% } %>
      <% if (rcDiensten.length) { %><div class="reclame__inline"><%= rcDiensten.slice(0, 6).join(' · ') %><%= rcDiensten.length > 6 ? ' · en meer' : '' %></div><% } %>
    </div>
    <div class="reclame__acties">
      <% if (rcLink) { %><a class="btn reclame__cta" href="<%= rcKlik %>" target="_blank" rel="noopener sponsored"><%= rcCta %> ↗</a><% } %>
      <% if (rcTel) { %><a class="btn btn--ghost" href="<%= rcTel %>">Bel <%= rc.telefoon %></a><% } else if (rcWa) { %><a class="btn btn--ghost" href="<%= rcWa %>" target="_blank" rel="noopener">WhatsApp</a><% } %>
    </div>
  </div>
</aside>
<% } %>
<% } %>
