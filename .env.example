# Kopieer dit bestand naar .env voor lokaal gebruik.
# Op Railway zet je deze waarden onder "Variables".

# Door Railway automatisch ingevuld als je de PostgreSQL-plugin toevoegt:
DATABASE_URL=postgresql://gebruiker:wachtwoord@localhost:5432/luchtmobiel

# Geheime sleutel voor sessies. Maak hier een lange willekeurige tekst van (30+ tekens).
# VERPLICHT in productie. Wijzig deze sleutel daarna niet zomaar: hij wordt ook
# gebruikt om 2FA-geheimen te versleutelen (tenzij je ENCRYPTIE_SLEUTEL instelt).
SESSION_SECRET=verander-mij-in-een-lange-willekeurige-tekst

# Optioneel: aparte sleutel voor het versleutelen van 2FA-geheimen in de database.
# Aanbevolen. Ook een lange willekeurige tekst. Daarna niet meer wijzigen.
ENCRYPTIE_SLEUTEL=

# Het eerste adminaccount (Daniël). Wordt automatisch aangemaakt bij de eerste start.
ADMIN_EMAIL=jij@voorbeeld.nl
ADMIN_PASSWORD=kies-een-sterk-wachtwoord
ADMIN_NAAM=Daniël de Graaf

# Toegangscode voor registratie. Leeg laten = iedereen mag registreren.
# Vul je iets in, dan hebben nieuwe leden deze code nodig om een account te maken.
REGISTRATIE_CODE=LUCHTMOBIEL

# Het adres van de site (zonder slash aan het eind). Wordt gebruikt in e-mails,
# bijvoorbeeld voor de "wachtwoord vergeten"-link.
APP_URL=https://jouw-app.up.railway.app

# E-mail via Resend (https://resend.com). Zonder RESEND_API_KEY worden er geen
# e-mails verstuurd en werkt "wachtwoord vergeten" niet.
RESEND_API_KEY=
# Afzender (domein moet in Resend geverifieerd zijn), bijv. "BCLMB <noreply@bclmb.nl>"
MAIL_VAN=BCLMB <onboarding@resend.dev>
# Optioneel: adres van het bestuur voor meldingen (nieuw lid, aanmeldingen, ...)
MAIL_BESTUUR=

# Zet op 'production' op Railway (zorgt voor veilige cookies via https).
NODE_ENV=production
