# Kopieer dit bestand naar .env voor lokaal gebruik.
# Op Railway zet je deze waarden onder "Variables".

# Door Railway automatisch ingevuld als je de PostgreSQL-plugin toevoegt:
DATABASE_URL=postgresql://gebruiker:wachtwoord@localhost:5432/luchtmobiel

# Geheime sleutel voor sessies. Maak hier een lange willekeurige tekst van (30+ tekens).
# VERPLICHT in productie. Wijzig deze sleutel daarna niet zomaar: hij wordt ook
# gebruikt om 2FA-geheimen te versleutelen (tenzij je ENCRYPTIE_SLEUTEL instelt).
SESSION_SECRET=verander-mij-in-een-lange-willekeurige-tekst

# Optioneel: aparte sleutel voor het versleutelen van 2FA-geheimen in de database.
# Aanbevolen. Ook een lange willekeurige tekst. Daarna niet meer wijzigen.
ENCRYPTIE_SLEUTEL=

# Zet op 1 om beheerders te verplichten tweestapsverificatie in te stellen
# voordat ze het beheerpaneel kunnen gebruiken (aanbevolen zodra je zelf 2FA hebt).
TFA_VERPLICHT_ADMIN=0

# Het eerste adminaccount (Daniël). Wordt automatisch aangemaakt bij de eerste start.
ADMIN_EMAIL=jij@voorbeeld.nl
ADMIN_PASSWORD=kies-een-sterk-wachtwoord
ADMIN_NAAM=Daniël de Graaf

# Toegangscode voor registratie. Leeg laten = iedereen mag registreren.
# Vul je iets in, dan hebben nieuwe leden deze code nodig om een account te maken.
REGISTRATIE_CODE=LUCHTMOBIEL

# Het adres van de site (zonder slash aan het eind). Wordt gebruikt in e-mails,
# bijvoorbeeld voor de "wachtwoord vergeten"-link.
APP_URL=https://jouw-app.up.railway.app

# E-mail via Resend (https://resend.com). Zonder RESEND_API_KEY worden er geen
# e-mails verstuurd en werkt "wachtwoord vergeten" niet.
RESEND_API_KEY=
# Afzender (domein moet in Resend geverifieerd zijn), bijv. "BCLMB <noreply@bclmb.nl>"
MAIL_VAN=BCLMB <onboarding@resend.dev>
# Optioneel: adres van het bestuur voor meldingen (nieuw lid, aanmeldingen, ...)
MAIL_BESTUUR=

# Agenda automatisch overnemen van de hoofdsite (bclmb.nl, Congressus).
# Aantal uren tussen twee imports; 0 = uit. Handmatig importeren kan altijd via Beheer.
AGENDA_IMPORT_UREN=6
# Alleen aanpassen als de hoofdsite verhuist:
# AGENDA_BRON_ICS=https://www.bclmb.nl/_ical/public.ics
# AGENDA_BRON_SITE=https://bclmb.nl

# Nieuws en blogs automatisch overnemen van de hoofdsite (bclmb.nl/service/nieuws en /service/blog).
# Aantal uren tussen twee imports; 0 = uit. NIEUWS_IMPORT_BLOG=0 laat de blogs weg.
NIEUWS_IMPORT_UREN=6
# NIEUWS_IMPORT_BLOG=1
# NIEUWS_BRON_SITE=https://www.bclmb.nl

# Sponsorverzoeken voor militairen en veteranen. Een dagelijkse Claude-routine zet haar
# vondsten in de repository (tak claude/sponsor-inbox); de site haalt die lijst periodiek op.
# Aantal uren tussen twee keer ophalen; 0 = uit. Handmatig ophalen kan altijd via Beheer.
SPONSOR_IMPORT_UREN=3
# Alleen aanpassen als de repository verhuist:
# SPONSOR_INBOX_URL=https://raw.githubusercontent.com/ddegraaf-max/Luchtmobiel/claude/sponsor-inbox/data/sponsorverzoeken.json

# Socialemedia-pagina's van de club (worden getoond in de footer en op "Over het netwerk").
# Leeg laten = niet tonen.
SOCIAL_LINKEDIN=https://www.linkedin.com/company/...
SOCIAL_FACEBOOK=https://www.facebook.com/...
SOCIAL_INSTAGRAM=https://www.instagram.com/...

# Robot-controle (Cloudflare Turnstile) op inloggen, registreren en wachtwoord vergeten.
# Maak gratis een widget aan op https://dash.cloudflare.com -> Turnstile en vul beide sleutels in.
# Leeg laten = geen robot-controle.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Zet op 'production' op Railway (zorgt voor veilige cookies via https).
NODE_ENV=production
